VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Must match server MASTER_ADMIN_PATH. This value is public and grants no access by itself.
VITE_MASTER_ADMIN_PATH=control-room
# Optional public Turnstile site key; use the same key as server/.env.
VITE_TURNSTILE_SITE_KEY=
