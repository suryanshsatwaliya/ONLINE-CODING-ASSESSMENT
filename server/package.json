{
  "name": "assessment-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/core.test.js tests/adapters.test.js",
    "test:integration": "node --test tests/integration.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.19.0",
    "socket.io": "^4.8.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^6.0.0",
    "zod": "^3.25.76",
    "helmet": "^8.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^8.1.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "supertest": "^7.1.4",
    "mongodb-memory-server": "^10.2.3"
  }
}
